# Скопируйте в .env — docker compose подхватит автоматически.
# Все секреты — только env, не в yaml и не в БД (docs/05 §5.11).

# Токен доступа API (single-user). Обязателен в compose.
TOKLIB_TOKEN=change-me

# Каталог данных (SQLite, media, tmp, config.yaml)
TOKLIB_DATA_DIR=./data

# Путь/URL БД (по умолчанию SQLite в data_dir; PostgreSQL для SaaS-профиля)
# TOKLIB_DATABASE_URL=postgresql+psycopg://toklib:pass@db:5432/toklib

# Секреты AI-провайдеров — нужны только при opt-in облака (docs/08 §8.5)
TOKLIB_LLM_KEY=
TOKLIB_STT_KEY=
TOKLIB_EMBED_KEY=

# Telegram-бот (MVP-канал приёма ссылок, docs/06 Р4)
TOKLIB_TG_BOT_TOKEN=
TOKLIB_TG_ALLOWED=

# URL API для бота
TOKLIB_API_URL=http://127.0.0.1:8000
